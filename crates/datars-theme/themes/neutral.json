{
  "name": "datars/neutral",
  "tokens": {
    "paper": "#ffffff",
    "ink": "#1d1f24",
    "ink-2": "mix($ink, $paper, 0.22)",
    "muted": "mix($ink, $paper, 0.35)",
    "grid": "mix($ink, $paper, 0.9)",
    "rule": "mix($ink, $paper, 0.6)",
    "surface": "mix($paper, $ink, 0.04)",
    "surface-ink": "$ink",
    "accent": "#4269d0",
    "accent-ink": "on($accent)",
    "mark": "$accent",
    "positive": "#2f8f5b",
    "negative": "#c8423b",
    "up": "$positive",
    "down": "$negative",
    "highlight": "#efb118",
    "dim": 0.28,
    "categorical": { "kind": "categorical", "colors": ["#4269d0", "#efb118", "#ff725c", "#6cc5b0", "#3ca951", "#9c6b4e", "#a463f2", "#97bbf5", "#ff8ab7", "#9498a0"] },
    "sequential": { "kind": "sequential", "colors": ["#eff3ff", "#bdd7e7", "#6baed6", "#3182bd", "#08519c"] },
    "diverging": { "kind": "diverging", "colors": ["#2166ac", "#92c5de", "#f2f2f2", "#f4a582", "#b2182b"] },
    "font.body": { "family": ["Inter"], "weight": 400, "src": "datars:fonts/Inter-Regular.ttf" },
    "font.strong": { "family": ["Inter"], "weight": 600, "src": "datars:fonts/Inter-SemiBold.ttf" },
    "font.title": { "family": ["Inter"], "weight": 700, "src": "datars:fonts/Inter-Bold.ttf" },
    "font.number": { "family": ["Inter"], "weight": 400, "src": "datars:fonts/Inter-Regular.ttf" },
    "size.small": 10,
    "size.label": 11,
    "size.body": 13,
    "size.title": 17,
    "radius.mark": 2,
    "radius.bar": 0,
    "stroke.line": 2,
    "stroke.rule": 1,
    "stroke.grid": 1,
    "point.radius": 4,
    "band.padding": 0.22,
    "motion.duration": 0.9,
    "motion.easing": "cubic-in-out",
    "motion.stagger": 0.3,
    "map.water": "#dfe9f3",
    "map.land": "#f4f3ef",
    "map.park": "#e3eedc",
    "map.building": "#e8e5df",
    "map.road": "#ffffff",
    "map.road-major": "#fbe7b8",
    "map.border": "mix($ink, $paper, 0.7)",
    "map.label": "$ink-2",
    "map.label-halo": "$paper",
    "map.marker": "$ink",
    "map.no-data": "mix($ink, $paper, 0.93)",
    "card": "mix($paper, $ink, 0.03)",
    "card-ink": "$ink",
    "card-ink-2": "$ink-2",
    "card-line": "mix($ink, $paper, 0.86)",
    "radius.card": 8
  },
  "modes": {
    "dark": {
      "paper": "#111318",
      "ink": "#eceef2",
      "surface": "mix($paper, $ink, 0.08)",
      "accent": "#7a9cf0",
      "positive": "#5cc48a",
      "negative": "#f07168",
      "sequential": { "kind": "sequential", "colors": ["#1f4570", "#2b64a0", "#428bcc", "#7ab6e6", "#d2e7f8"] },
      "map.water": "#16202c",
      "map.land": "#1b1e24",
      "map.park": "#1c2620",
      "map.building": "#23262d",
      "map.road": "#2b2f37",
      "map.road-major": "#4a3f28",
      "map.no-data": "mix($ink, $paper, 0.88)",
      "card": "mix($paper, $ink, 0.07)",
      "card-line": "mix($ink, $paper, 0.8)"
    },
    "high-contrast": {
      "paper": "#ffffff",
      "ink": "#000000",
      "muted": "mix($ink, $paper, 0.25)",
      "grid": "mix($ink, $paper, 0.7)",
      "rule": "$ink",
      "accent": "#1f45b8",
      "dim": 0.18
    }
  },
  "checks": [
    { "contrast": ["ink", "paper"], "min": 7 },
    { "contrast": ["ink-2", "paper"], "min": 4.5 },
    { "contrast": ["muted", "paper"], "min": 4.5 },
    { "contrast": ["accent-ink", "accent"], "min": 4.5 },
    { "contrast": ["surface-ink", "surface"], "min": 7 },
    { "distinct": "categorical", "min": 8, "cvd": true, "first": 8 },
    { "monotone": "sequential" }
  ]
}
