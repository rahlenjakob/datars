    ]
   },
   "key": [
    "name"
   ]
  },
  "sights": {
   "values": {
    "id": [
     "slottet",
     "stadshuset",
     "vasa",
     "skansen",
     "grona-lund",
     "fotografiska",
     "nationalmuseum",
     "central"
    ],
    "name": [
     "Royal Palace",
     "City Hall",
     "Vasa Museum",
     "Skansen",
     "Gröna Lund",
     "Fotografiska",
     "Nationalmuseum",
