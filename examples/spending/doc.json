 "tables": {
  "byCategory": {
   "from": "spending",
   "ops": [
    {
     "op": "aggregate",
     "groupby": [
      "category"
     ],
     "ops": [
      {
       "as": "amount",
       "op": "sum",
       "field": "amount"
      }
     ]
    },
    {
     "op": "sort",
     "by": [
      [
       "amount",
       "desc"
      ]
     ]
    }
   ]
  }
 },
 "signals": {
  "view": {
   "type": "str",
   "default": "months"
  }
 },
 "keys": {
  "Housing": {
   "color": "#4269d0"
  },
  "Food": {
   "color": "#efb118"
  },
  "Transport": {
   "color": "#6cc5b0"
  },
  "Shopping": {
   "color": "#ff725c"
  },
  "Leisure": {
   "color": "#a463f2"
  }
 },
 "scene": {
  "kind": "group",
  "key": "root",
  "layout": {
   "type": "stack",
   "padding": [
    16,
    16,
    12,
    12
   ]
  },
  "children": [
   {
    "kind": "use",
    "recipe": "@datars/std/plot",
    "params": {
     "data": "spending",
     "x": "month",
     "y": "amount",
     "color": "category",
     "title": "Spending per month",
     "legend": true,
     "format": ",.0f",
     "suffix": " kr",
     "children": [
      {
       "kind": "use",
       "recipe": "@datars/std/stacked",
       "params": {
        "series": "category"
       }
      }
     ]
    },
    "key": "chart",
    "when": {
     "expr": "view == \"months\""
    }
   },
   {
    "kind": "use",
    "recipe": "@datars/std/plot",
    "params": {
     "data": "byCategory",
     "x": "amount",
     "y": "category",
     "xType": "linear",
     "yType": "band",
     "color": "category",
     "title": "Where it went",
     "children": [
      {
       "kind": "use",
       "recipe": "@datars/std/bar",
       "params": {
        "labels": true,
        "format": ",.0f",
        "suffix": " kr"
       }
      }
     ]
    },
    "key": "chart",
    "when": {
     "expr": "view == \"categories\""
    }
   },
   {
    "kind": "use",
    "recipe": "@datars/std/card",
    "params": {
     "title": {
      "expr": "`${format(table.sum(\"spending\", \"amount\"), \",.0f\")} kr`"
     },
     "text": {
      "expr": "narration.text"
     },
     "width": 200
    },
    "key": "caption"
   }
  ]
 },
 "program": {
  "preset": "story",
  "states": [
   {
    "name": "months",
    "set": {
     "view": "months"
    },
    "narration": {
     "text": "spent over the last six months."
    }
   },
   {
    "name": "categories",
    "set": {
     "view": "categories"
    },
    "narration": {
     "text": "Housing is the biggest share; each month's bars add up here."
    }
   }
  ],
  "drivers": [
   "steps",
   "keys"
  ]
 }
}
