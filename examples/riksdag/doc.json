     "children": [
      {
       "kind": "use",
       "recipe": "@datars/std/bar",
       "params": {
        "labels": true,
        "format": ",.0f"
       }
      }
     ]
    },
    "key": "chart",
    "when": {
     "expr": "view == \"bars\""
    }
   }
  ]
 },
 "program": {
  "preset": "story",
  "states": [
   {
    "name": "seats",
