     "op": "filter",
     "expr": {
      "expr": "[\"ISL\",\"NOR\",\"SWE\",\"FIN\",\"DNK\"].includes(d.id)"
     }
    },
    {
     "op": "sort",
     "by": [
      [
       "share",
       "desc"
      ]
     ]
    }
   ]
  }
 },
 "signals": {
  "focus": {
   "type": "keyset",
   "default": []
  },
  "shape": {
   "type": "str",
   "default": "map"
  }
 },
 "scene": {
  "kind": "group",
  "key": "root",
  "layout": {
   "type": "stack",
   "padding": [
    16,
    20,
    12,
    12
   ]
  },
  "children": [
   {
    "kind": "view",
    "key": "chart",
    "when": {
     "expr": "shape == \"map\""
    },
    "camera": {
     "fit": {
      "keys": "=focus"
     },
     "padding": 24
    },
    "children": [
     {
      "kind": "use",
      "recipe": "@datars/std/map",
      "params": {
       "source": "world",
       "data": "renew",
       "key": "id",
       "value": "share",
       "projection": "equal-earth",
       "format": ".0f"
      }
     }
    ]
   },
   {
    "kind": "use",
    "recipe": "@datars/std/plot",
    "params": {
     "data": "nordic",
     "x": "share",
     "y": "name",
     "xType": "linear",
     "yType": "band",
     "title": "Renewable share of energy use (%)",
     "format": ".0f",
     "children": [
      {
       "kind": "use",
       "recipe": "@datars/std/bar",
       "params": {
        "labels": true,
        "fill": "$accent"
       }
      }
     ]
    },
    "key": "chart",
    "when": {
     "expr": "shape == \"bars\""
    }
   }
  ]
 },
 "motion": {
  "rules": [
   {
    "matcher": "by-key",
    "select": {
     "role": "region"
    }
   },
   {
    "matcher": "by-key",
    "select": {
     "role": "datum"
    }
   }
  ]
 },
