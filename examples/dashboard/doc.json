    {
     "op": "aggregate",
     "groupby": [
      "region"
     ],
     "ops": [
      {
       "op": "sum",
       "field": "sales",
       "as": "total"
      }
     ]
    }
   ]
  },
  "trend": {
   "from": "sales",
   "ops": [
    {
     "op": "filter",
     "expr": {
      "expr": "selected.isEmpty() || selected.has(d.region)"
     }
    }
   ]
  }
 },
 "signals": {
  "selected": {
   "type": "keyset",
   "default": []
  }
 },
 "scene": {
  "kind": "group",
  "key": "root",
  "layout": {
   "type": "columns",
   "gap": 24,
   "padding": [
    16,
    20,
    12,
    12
   ],
   "wrap": 560
  },
  "children": [
   {
    "kind": "use",
    "recipe": "@datars/std/plot",
    "params": {
     "data": "totals",
     "x": "region",
     "y": "total",
     "color": "region",
     "title": "Total (click to filter)",
     "children": [
      {
       "kind": "use",
       "recipe": "@datars/std/bar",
       "params": {
        "selected": "selected"
       }
      }
     ]
    },
    "key": "totals",
    "size": {
     "w": "40%"
    }
   },
   {
    "kind": "use",
    "recipe": "@datars/std/plot",
    "params": {
     "data": "trend",
     "x": "month",
     "y": "sales",
     "xType": "linear",
     "color": "region",
     "title": "Monthly sales",
     "zero": false,
     "children": [
      {
       "kind": "use",
       "recipe": "@datars/std/line",
       "params": {
        "points": true
       }
      }
     ]
    },
    "key": "trend"
   }
  ]
 },
 "program": {
  "preset": "interactive",
  "states": [
   {
    "name": "main"
   }
  ]
