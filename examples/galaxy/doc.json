{"datars":1,"id":"galaxy","title":"4,000,000 stars","description":"A synthetic barred spiral galaxy of four million stars, generated from a seed and drawn with level of detail: pan and zoom from the whole galaxy down to single stars.","size":{"width":1000,"height":680},"theme":{"use":"datars/neutral","tokens":{"paper":"#03050c","ink":"#eef1ff","ink-2":"#c3cbe8","muted":"#8a93b5","rule":"#2a3150"}},"locale":"en","data":{"stars":{"generate":{"rows":4000000,"columns":[{"as":"part","expr":"rand(d.i, 1) < 0.14 ? 0 : rand(d.i, 1) < 0.16 ? 1 : rand(d.i, 1) < 0.18 ? 2 : rand(d.i, 1) < 0.36 ? 3 : 4"},{"as":"arm","expr":"rand(d.i, 2) < 0.37 ? 0 : rand(d.i, 2) < 0.74 ? 1 : rand(d.i, 2) < 0.87 ? 2 : 3"},{"as":"r","expr":"d.part == 1 ? min(62400, 2500 / sqrt(max(rand(d.i, 3), 0.0016))) : d.part == 3 ? 1800 + -9500 * log(1 - rand(d.i, 3) * 0.9958042543625302) : 5200 + -11000 * log(1 - rand(d.i, 3) * 0.991149423910948)"},{"as":"theta","expr":"d.part == 4 ? log(d.r / 5200) / 0.3 + [0, 3.141592653589793, 1.5707963267948966, 4.71238898038469][d.arm] + randn(d.i, 4) * (0.11 + 700 / d.r) : rand(d.i, 4) * 6.283185307179586"},{"as":"cluster","expr":"floor(rand(d.i, 5) * 160)"},{"as":"cf","expr":"d.cluster * 0.7548776662 - floor(d.cluster * 0.7548776662)"},{"as":"cr","expr":"6000 + 30000 * pow(d.cf, 1.2)"},{"as":"bx","expr":"rand(d.i, 6) < 0.3 ? randn(d.i, 7) * 1300 : randn(d.i, 7) * 3300"},{"as":"by","expr":"rand(d.i, 6) < 0.3 ? randn(d.i, 8) * 1200 : randn(d.i, 8) * 950"},{"as":"x","expr":"round(d.part == 0 ? d.bx : d.part == 2 ? d.cr * cos(d.cluster * 2.399963) + randn(d.i, 9) * (25 + 35 * rand(d.cluster, 93)) : d.r * cos(d.theta), 2)"},{"as":"y","expr":"round(d.part == 0 ? d.by : d.part == 2 ? d.cr * sin(d.cluster * 2.399963) + randn(d.i, 10) * (25 + 35 * rand(d.cluster, 93)) : d.r * sin(d.theta), 2)"},{"as":"young","expr":"d.part == 4 || (d.part == 3 && rand(d.i, 11) < 0.3)"},{"as":"lo","expr":"d.young ? 0.3 : 0.1"},{"as":"mass","expr":"d.lo * pow(1 - rand(d.i, 12) * (1 - pow(d.lo / (d.young ? 60 : 0.95), 1.35)), -1 / 1.35)"},{"as":"giant","expr":"!d.young && rand(d.i, 13) < 0.07"},{"as":"temp","expr":"round((d.giant ? 3500 + 1300 * rand(d.i, 14) : d.mass >= 1 ? 5772 * pow(d.mass, 0.505) : 5772 * pow(d.mass, 0.38)) / 10) * 10"},{"as":"lum","expr":"round(d.giant ? 1.4 + 1.4 * rand(d.i, 15) : clamp(3.5 * log10(d.mass), -3, 5.8), 1)"}],"keep":["x","y","temp","lum"]}}},"signals":{"bx0":{"type":"num","default":-40000},"by0":{"type":"num","default":-40000},"bx1":{"type":"num","default":40000},"by1":{"type":"num","default":40000}},"scene":{"kind":"group","key":"root","children":[{"kind":"use","recipe":"@datars/std/cloud","params":{"data":"stars","x":"x","y":"y","bbox":[{"expr":"bx0"},{"expr":"by0"},{"expr":"bx1"},{"expr":"by1"}],"padding":12,"explore":"sky","maxZoom":3000,"points":80000,"glow":6,"glowOpacity":{"expr":"clamp(0.03 + 0.03 * d.lum, 0.015, 0.2)"},"glowPoints":30000,"r":{"expr":"clamp(0.95 + 0.34 * d.lum, 0.75, 3.6)"},"opacity":{"expr":"clamp(0.62 + 0.16 * d.lum, 0.22, 1)"},"fill":{"expr":"d.temp < 3700 ? \"#ffb06e\" : d.temp < 5200 ? \"#ffd29c\" : d.temp < 6000 ? \"#fff0d6\" : d.temp < 7500 ? \"#f7f5ff\" : d.temp < 10000 ? \"#d8e2ff\" : d.temp < 30000 ? \"#aec2ff\" : \"#98afff\""},"label":{"expr":"`Star ${format(d.$row + 1, \",\")} · ${d.temp < 3700 ? \"M\" : d.temp < 5200 ? \"K\" : d.temp < 6000 ? \"G\" : d.temp < 7500 ? \"F\" : d.temp < 10000 ? \"A\" : d.temp < 30000 ? \"B\" : \"O\"} · ${format(d.temp, \",\")} K · ${format(pow(10, d.lum), \",.2~r\")} suns · ${format(sqrt(d.x * d.x + d.y * d.y), \",.0f\")} ly from the centre`"},"name":"4,000,000 stars"},"key":"sky"},{"kind":"text","key":"title","text":"4,000,000 stars","at":[22,20],"style":{"font":"font.title","size":22,"ink":"$ink","baseline":"top"},"halo":["$paper",3]},{"kind":"text","key":"subtitle","text":"A barred spiral, generated from a seed","at":[22,50],"style":{"size":12.5,"ink":"$ink-2","baseline":"top"},"halo":["$paper",3]},{"kind":"group","key":"scale","children":[{"kind":"shape","key":"bar","geom":{"type":"rect","x":22,"y":{"expr":"box.h - 26"},"w":{"expr":"((110 / (min((box.w - 24) / (bx1 - bx0), (box.h - 24) / (by1 - by0)) * (sky.zoom ?? 1))) / pow(10, floor(log10((110 / (min((box.w - 24) / (bx1 - bx0), (box.h - 24) / (by1 - by0)) * (sky.zoom ?? 1)))))) < 2 ? 1 : (110 / (min((box.w - 24) / (bx1 - bx0), (box.h - 24) / (by1 - by0)) * (sky.zoom ?? 1))) / pow(10, floor(log10((110 / (min((box.w - 24) / (bx1 - bx0), (box.h - 24) / (by1 - by0)) * (sky.zoom ?? 1)))))) < 5 ? 2 : 5) * pow(10, floor(log10((110 / (min((box.w - 24) / (bx1 - bx0), (box.h - 24) / (by1 - by0)) * (sky.zoom ?? 1)))))) * (min((box.w - 24) / (bx1 - bx0), (box.h - 24) / (by1 - by0)) * (sky.zoom ?? 1))"},"h":2},"fill":"$ink-2"},{"kind":"text","key":"label","text":{"expr":"format(((110 / (min((box.w - 24) / (bx1 - bx0), (box.h - 24) / (by1 - by0)) * (sky.zoom ?? 1))) / pow(10, floor(log10((110 / (min((box.w - 24) / (bx1 - bx0), (box.h - 24) / (by1 - by0)) * (sky.zoom ?? 1)))))) < 2 ? 1 : (110 / (min((box.w - 24) / (bx1 - bx0), (box.h - 24) / (by1 - by0)) * (sky.zoom ?? 1))) / pow(10, floor(log10((110 / (min((box.w - 24) / (bx1 - bx0), (box.h - 24) / (by1 - by0)) * (sky.zoom ?? 1)))))) < 5 ? 2 : 5) * pow(10, floor(log10((110 / (min((box.w - 24) / (bx1 - bx0), (box.h - 24) / (by1 - by0)) * (sky.zoom ?? 1)))))), \",\") + \" light-years\""},"at":[22,{"expr":"box.h - 32"}],"style":{"size":11.5,"ink":"$ink-2","baseline":"bottom"},"halo":["$paper",3]}]},{"kind":"group","key":"legend","children":[{"kind":"text","key":"M","text":"M","at":[{"expr":"box.w - 124"},{"expr":"box.h - 24"}],"style":{"size":12,"weight":600,"ink":"#ffb06e","align":"end","baseline":"middle"},"halo":["$paper",3]},{"kind":"text","key":"K","text":"K","at":[{"expr":"box.w - 107"},{"expr":"box.h - 24"}],"style":{"size":12,"weight":600,"ink":"#ffd29c","align":"end","baseline":"middle"},"halo":["$paper",3]},{"kind":"text","key":"G","text":"G","at":[{"expr":"box.w - 90"},{"expr":"box.h - 24"}],"style":{"size":12,"we