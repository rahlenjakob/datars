{
 "datars": 1,
 "id": "shapes",
 "title": "One dataset, many shapes",
 "size": {
  "width": 760,
  "height": 460
 },
 "locale": "en",
 "data": {
  "votes": {
   "values": {
    "party": [
     "S",
     "SD",
     "M",
     "V",
     "C",
     "KD",
     "MP",
     "L"
    ],
    "share": [
     30.3,
     20.5,
     19.1,
     6.8,
     6.7,
     5.3,
     5.1,
     4.6
    ]
   },
   "key": [
    "party"
   ]
  }
 },
 "signals": {
  "shape": {
   "type": "str",
   "default": "bars"
  }
 },
 "keys": {
  "S": {
   "color": "#e8112d"
  },
  "SD": {
   "color": "#dddd00"
  },
  "M": {
   "color": "#1b49dd"
  },
  "V": {
   "color": "#a01313"
  },
  "C": {
   "color": "#009933"
  },
  "KD": {
   "color": "#005ea8"
  },
  "MP": {
   "color": "#83cf39"
  },
  "L": {
   "color": "#3a8fd6"
  }
 },
 "scene": {
  "kind": "group",
  "key": "root",
  "layout": {
   "type": "stack",
   "padding": [
    16,
    20,
    12,
    12
   ]
  },
  "children": [
   {
    "kind": "use",
    "recipe": "@datars/std/plot",
    "params": {
     "data": "votes",
     "x": "party",
     "y": "share",
     "color": "party",
     "title": "Vote share, 2022 (%)",
     "children": [
      {
       "kind": "use",
       "recipe": "@datars/std/bar",
       "params": {
        "labels": true
       }
      }
     ]
    },
    "key": "chart",
    "when": {
     "expr": "shape == \"bars\""
    }
   },
   {
    "kind": "use",
    "recipe": "@datars/std/treemap",
    "params": {
     "data": "votes",
     "value": "share",
     "category": "party"
    },
    "key": "chart",
    "when": {
     "expr": "shape == \"treemap\""
    }
   },
   {
    "kind": "use",
    "recipe": "@datars/std/waffle",
    "params": {
     "data": "votes",
     "value": "share",
     "category": "party"
    },
    "key": "chart",
    "when": {
     "expr": "shape == \"waffle\""
    }
   },
   {
    "kind": "use",
    "recipe": "@datars/std/plot",
    "params": {
     "data": "votes",
     "x": "share",
     "y": "party",
     "xType": "linear",
     "yType": "band",
     "color": "party",
     "title": "As dots",
     "children": [
      {
       "kind": "use",
       "recipe": "@datars/std/dot",
       "params": {
        "r": 7
       }
      }
     ]
    },
    "key": "chart",
    "when": {
     "expr": "shape == \"dots\""
    }
   }
  ]
 },
 "motion": {
  "rules": [
   {
    "matcher": "by-key",
    "duration": 1.1,
    "select": {
     "role": "datum"
    }
   }
  ]
 },
 "program": {
  "preset": "story",
  "states": [
   {
    "name": "bars",
    "set": {
     "shape": "bars"
    }
   },
   {
    "name": "treemap",
    "set": {
     "shape": "treemap"
    }
   },
   {
    "name": "waffle",
    "set": {
     "shape": "waffle"
    }
   },
   {
    "name": "dots",
    "set": {
     "shape": "dots"
    }
   }
  ],
  "drivers": [
   "steps",
   "keys"
  ]
 }
}
